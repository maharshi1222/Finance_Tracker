<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="16dp"
    tools:context=".AboutApp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="12dp"
        app:strokeColor="#000000"
        app:strokeWidth="4dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/budgetbee_logo" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/backArrow3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"/>

        <TextView
            android:id="@+id/tvAboutApp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="About App"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/topIcon3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/information"
            android:contentDescription="Icon"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#B8C8C8" />

    <TextView
        android:id="@+id/textView61"
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <TextView
        android:id="@+id/textView63"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text='It is an Android-based mobile application name "BudgetBEE" designed to help users monitor and manage their personal finances effectively. The app allows users to track income and expenses, categorize transactions, visualize spending patterns, and set budgets. With a clean and user-friendly interface, it aims to simplify financial management and promote better money habits.'
        android:textColor="#212121"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/textView64"
        android:layout_width="match_parent"
        android:layout_height="30dp" />

    <TextView
        android:id="@+id/textView65"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Email : abcd@gmail.com\n\nContact Us on : 1234567891 \n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tbudgetbee@gmail.com"
        android:textColor="#212121"
        android:textSize="18sp" />
</LinearLayout>