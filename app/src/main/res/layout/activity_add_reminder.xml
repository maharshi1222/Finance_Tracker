<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="16dp"
    tools:context=".Add_reminder">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="12dp"
        app:strokeColor="#000000"
        app:strokeWidth="4dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/budgetbee_logo" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/backArrow2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:contentDescription="Back"/>

        <TextView
            android:id="@+id/tvAddReminder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Reminder"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/topIcon2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/reminder"
            android:contentDescription="Icon"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#B8C8C8" />

    <!-- Date and Time Selection -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:padding="8dp">

        <ImageView
            android:id="@+id/icCalendar2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/calendar"
            android:contentDescription="Calendar"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/Date2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textSize="16sp"
            android:textColor="#757575"
            android:layout_marginEnd="16dp"/>

        <ImageView
            android:id="@+id/icClock2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/clock"
            android:contentDescription="Clock"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/Time2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textSize="16sp"
            android:textColor="#757575"/>
    </LinearLayout>

    <!-- Note Input Section -->
    <LinearLayout
        android:id="@+id/noteContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:id="@+id/noteLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/noteIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="Note Icon"
                android:src="@drawable/event_note" />

            <EditText
                android:id="@+id/noteInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Enter Your Reminder"
                android:padding="8dp"
                android:textSize="16sp"
                android:textColor="#212121"
                android:textColorHint="#757575" />

            <ImageView
                android:id="@+id/dateset"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="16dp"
                app:srcCompat="@drawable/calendar" />

            <ImageView
                android:id="@+id/timeset"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="16dp"
                app:srcCompat="@drawable/clock" />
        </LinearLayout>
    </LinearLayout>

    <!-- Add Reminder Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/addNoteCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#2E7D32">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add Reminder"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Add Button -->
    <Button
        android:id="@+id/btnAddremainder"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Add"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2E7D32"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"/>
</LinearLayout>